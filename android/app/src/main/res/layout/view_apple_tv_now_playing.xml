<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_obsidian">

    <!-- Layer 1: Blurred Ambient Glow from Album Art (Apple TV tvOS dynamic atmosphere) -->
    <ImageView
        android:id="@+id/imgAmbientGlow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.45"
        android:scaleType="centerCrop" />

    <!-- Layer 2: Apple TV Dark Radial & Gradient Scrim for contrast -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#A60A0A0C" />

    <!-- Layer 3: Main Music Content (Centered Layout) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp">

        <!-- Album Cover Art (tvOS rounded card with elevation shadow) -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="380dp"
                android:layout_height="380dp"
                android:layout_gravity="center"
                app:cardCornerRadius="28dp"
                app:cardElevation="36dp"
                app:cardBackgroundColor="#1A2228">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Default Placeholder Icon -->
                    <ImageView
                        android:id="@+id/imgDefaultMusicIcon"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_gravity="center"
                        android:alpha="0.3"
                        android:src="@drawable/ic_music_note"
                        app:tint="@color/text_white" />

                    <!-- High-Resolution Cover Art -->
                    <ImageView
                        android:id="@+id/imgAlbumCover"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop" />

                    <!-- Subtle Glass Edge Border -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_pin_box"
                        android:alpha="0.35" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>
        </FrameLayout>

        <!-- Track Metadata (Centered under cover) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Track Title -->
            <TextView
                android:id="@+id/txtTrackTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/sf_pro_display"
                android:gravity="center"
                android:maxWidth="750dp"
                android:maxLines="2"
                android:text="Título da Música"
                android:textAlignment="center"
                android:textColor="@color/text_white"
                android:textSize="34sp"
                android:textStyle="bold" />

            <!-- Artist Name -->
            <TextView
                android:id="@+id/txtArtistName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:fontFamily="@font/sf_pro_display"
                android:gravity="center"
                android:maxWidth="750dp"
                android:maxLines="1"
                android:text="Nome do Artista"
                android:textAlignment="center"
                android:textColor="#E0E0E0"
                android:textSize="22sp" />

            <!-- Album Name -->
            <TextView
                android:id="@+id/txtAlbumName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="@font/sf_pro_display"
                android:gravity="center"
                android:maxWidth="750dp"
                android:maxLines="1"
                android:text="Álbum"
                android:textAlignment="center"
                android:textColor="#80FFFFFF"
                android:textSize="16sp" />

        </LinearLayout>
    </LinearLayout>

</FrameLayout>
