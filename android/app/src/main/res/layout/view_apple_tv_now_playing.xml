<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0C">

    <!-- Layer 1: Blurred Ambient Glow from Album Art (Apple Music dynamic atmosphere) -->
    <ImageView
        android:id="@+id/imgAmbientGlow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.55"
        android:scaleType="centerCrop" />

    <!-- Layer 2: Apple Music Dark Scrim Vignette for deep contrast -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#A606060A" />

    <!-- Layer 3: Top Center Handle Capsule Indicator (iPhone Duo / Apple Music grabber) -->
    <View
        android:layout_width="36dp"
        android:layout_height="5dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_glass_pill"
        android:alpha="0.4" />

    <!-- Layer 4: Apple Music Landscape Split Canvas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="52dp"
        android:paddingTop="32dp"
        android:paddingEnd="44dp"
        android:paddingBottom="24dp">

        <!-- ================= LEFT COLUMN: Artwork, Track Info & Playback Controls ================= -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingEnd="28dp">

            <!-- Album Artwork Card -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start">

                <androidx.cardview.widget.CardView
                    android:layout_width="310dp"
                    android:layout_height="310dp"
                    app:cardBackgroundColor="#1A2026"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="28dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/imgDefaultMusicIcon"
                            android:layout_width="88dp"
                            android:layout_height="88dp"
                            android:layout_gravity="center"
                            android:alpha="0.25"
                            android:src="@drawable/ic_music_note"
                            app:tint="@color/text_white" />

                        <ImageView
                            android:id="@+id/imgAlbumCover"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop" />

                        <!-- Subtle glass edge border -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_pin_box"
                            android:alpha="0.25" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>
            </FrameLayout>

            <!-- Song Title, Artist & Action Icons -->
            <LinearLayout
                android:layout_width="310dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtTrackTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/sf_pro_rounded"
                        android:maxLines="1"
                        android:text="Título da Música"
                        android:textColor="@color/text_white"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtArtistName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/sf_pro_display"
                        android:maxLines="1"
                        android:text="Nome do Artista"
                        android:textColor="#B3FFFFFF"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- Favorite Star & More Options -->
                <ImageView
                    android:id="@+id/btnFavoriteStar"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:alpha="0.8"
                    android:src="@drawable/ic_star_outline"
                    app:tint="@color/text_white" />

                <ImageView
                    android:id="@+id/btnMoreOptions"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:alpha="0.8"
                    android:src="@drawable/ic_more_dots"
                    app:tint="@color/text_white" />
            </LinearLayout>

            <!-- Scrubber Track & Timestamps -->
            <LinearLayout
                android:layout_width="310dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <ProgressBar
                    android:id="@+id/scrubberProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:max="1000"
                    android:progress="250"
                    android:progressDrawable="@drawable/apple_tv_progress_bar" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtTimeElapsed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sf_pro_display"
                        android:text="0:00"
                        android:textColor="#70FFFFFF"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/txtTimeRemaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sf_pro_display"
                        android:text="-0:00"
                        android:textColor="#70FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Transport Control Row -->
            <LinearLayout
                android:layout_width="310dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnShuffle"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:alpha="0.4"
                    android:src="@drawable/ic_shuffle"
                    app:tint="@color/text_white" />

                <ImageView
                    android:id="@+id/btnPreviousTrack"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="26dp"
                    android:alpha="0.85"
                    android:src="@drawable/ic_skip_previous"
                    app:tint="@color/text_white" />

                <ImageView
                    android:id="@+id/btnPlayPause"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    android:alpha="1.0"
                    android:src="@drawable/ic_pause"
                    app:tint="@color/text_white" />

                <ImageView
                    android:id="@+id/btnNextTrack"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginEnd="26dp"
                    android:alpha="0.85"
                    android:src="@drawable/ic_skip_next"
                    app:tint="@color/text_white" />

                <ImageView
                    android:id="@+id/btnRepeat"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:alpha="0.4"
                    android:src="@drawable/ic_repeat"
                    app:tint="@color/text_white" />
            </LinearLayout>

            <!-- Volume Slider & AirPlay Info Row -->
            <LinearLayout
                android:layout_width="310dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:alpha="0.5"
                    android:src="@drawable/ic_speaker_low"
                    app:tint="@color/text_white" />

                <ProgressBar
                    android:id="@+id/volumeProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="70"
                    android:progressDrawable="@drawable/apple_tv_progress_bar" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:alpha="0.5"
                    android:src="@drawable/ic_speaker_high"
                    app:tint="@color/text_white" />

                <!-- AirPlay Connected Glyph Indicator -->
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="18dp"
                    android:alpha="0.65"
                    android:src="@drawable/ic_airplay"
                    app:tint="@color/text_white" />
            </LinearLayout>

        </LinearLayout>


        <!-- ================= RIGHT COLUMN: Apple Music Live Synced Lyrics ================= -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_weight="1.25"
            android:orientation="vertical">

            <!-- Top Header of Lyrics Pane: Sing/Mic Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:paddingTop="4dp"
                android:paddingEnd="12dp">

                <!-- Apple Music Sing (Karaoke) Button in Liquid Glass Pill -->
                <FrameLayout
                    android:id="@+id/btnMicKaraoke"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_liquid_glass_circle">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:alpha="0.9"
                        android:src="@drawable/ic_mic_sparkle"
                        app:tint="@color/text_white" />
                </FrameLayout>
            </LinearLayout>

            <!-- Time-Synced Lyrics Container -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerLyrics"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:requiresFadingEdge="vertical"
                    android:fadingEdgeLength="80dp"
                    android:paddingTop="60dp"
                    android:paddingBottom="240dp" />

                <!-- Fallback when lyrics are unavailable -->
                <TextView
                    android:id="@+id/txtNoLyrics"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:fontFamily="@font/sf_pro_rounded"
                    android:text="Letras indisponíveis para esta faixa"
                    android:textColor="#50FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Bottom Action Row: Lyrics Bubble and Queue List -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:paddingBottom="4dp">

                <!-- Selected Lyrics Quote Bubble -->
                <FrameLayout
                    android:id="@+id/btnLyricsBubble"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_liquid_glass_circle">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:alpha="1.0"
                        android:src="@drawable/ic_quote_bubble"
                        app:tint="@color/text_white" />
                </FrameLayout>

                <!-- Queue List Button -->
                <FrameLayout
                    android:id="@+id/btnQueueList"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_liquid_glass_circle">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:alpha="0.6"
                        android:src="@drawable/ic_queue_list"
                        app:tint="@color/text_white" />
                </FrameLayout>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- Legacy compatibility stub -->
    <TextView
        android:id="@+id/txtAlbumName"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</FrameLayout>
