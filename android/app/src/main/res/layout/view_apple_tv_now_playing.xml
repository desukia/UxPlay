<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_obsidian">

    <!-- Layer 1: Blurred Ambient Glow from Album Art (Apple TV tvOS dynamic atmosphere) -->
    <ImageView
        android:id="@+id/imgAmbientGlow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.45"
        android:scaleType="centerCrop" />

    <!-- Layer 2: Apple TV Dark Radial & Gradient Scrim for contrast -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#A60A0A0C" />

    <!-- Layer 3: Main Music Content (Apple TV tvOS layout) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="88dp"
        android:paddingEnd="88dp">

        <!-- Album Cover Art (tvOS large rounded 380dp card with drop shadow) -->
        <FrameLayout
            android:layout_width="400dp"
            android:layout_height="400dp">

            <!-- Card Container -->
            <androidx.cardview.widget.CardView
                android:layout_width="380dp"
                android:layout_height="380dp"
                android:layout_gravity="center"
                app:cardCornerRadius="28dp"
                app:cardElevation="32dp"
                app:cardBackgroundColor="#1A2228">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Default Placeholder Icon -->
                    <ImageView
                        android:id="@+id/imgDefaultMusicIcon"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_gravity="center"
                        android:alpha="0.3"
                        android:src="@drawable/ic_music_note"
                        app:tint="@color/text_white" />

                    <!-- High-Resolution Cover Art -->
                    <ImageView
                        android:id="@+id/imgAlbumCover"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop" />

                    <!-- Subtle Glass Edge Border -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_pin_box"
                        android:alpha="0.35" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>
        </FrameLayout>

        <!-- Track Metadata & Progress -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="64dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Badges Row: AirPlay + Lossless -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- AirPlay Audio Badge -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_pill"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="5dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_airplay"
                        app:tint="@color/text_white" />

                    <TextView
                        android:id="@+id/txtAirPlayBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sf_pro_rounded"
                        android:text="AirPlay Áudio"
                        android:textColor="@color/text_white"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Lossless Audio Badge -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_lossless_badge"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp">

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_lossless"
                        app:tint="#D1D5DB" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sf_pro_rounded"
                        android:text="Lossless"
                        android:textColor="#E5E7EB"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Track Title -->
            <TextView
                android:id="@+id/txtTrackTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/sf_pro_display"
                android:maxLines="2"
                android:text="Título da Música"
                android:textColor="@color/text_white"
                android:textSize="36sp"
                android:textStyle="bold" />

            <!-- Artist Name -->
            <TextView
                android:id="@+id/txtArtistName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:fontFamily="@font/sf_pro_display"
                android:maxLines="1"
                android:text="Nome do Artista"
                android:textColor="#E0E0E0"
                android:textSize="22sp" />

            <!-- Album Name -->
            <TextView
                android:id="@+id/txtAlbumName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="@font/sf_pro_display"
                android:maxLines="1"
                android:text="Álbum"
                android:textColor="#80FFFFFF"
                android:textSize="16sp" />

            <!-- Authentic Apple TV Progress Bar -->
            <ProgressBar
                android:id="@+id/audioProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="32dp"
                android:max="1000"
                android:progress="0"
                android:progressDrawable="@drawable/apple_tv_progress_bar" />

            <!-- Elapsed & Remaining Timestamps -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/txtElapsedTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:fontFamily="@font/sf_pro_rounded"
                    android:text="0:00"
                    android:textColor="#80FFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtRemainingTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:fontFamily="@font/sf_pro_rounded"
                    android:text="--:--"
                    android:textColor="#80FFFFFF"
                    android:textSize="13sp" />
            </RelativeLayout>

        </LinearLayout>
    </LinearLayout>

</FrameLayout>
