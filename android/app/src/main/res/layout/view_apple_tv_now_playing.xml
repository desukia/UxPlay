<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_obsidian">

    <!-- Layer 1: Blurred Ambient Glow from Album Art (Apple Music dynamic atmosphere) -->
    <ImageView
        android:id="@+id/imgAmbientGlow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.55"
        android:scaleType="centerCrop" />

    <!-- Layer 2: Apple Music Dark Scrim Vignette for deep contrast -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99060608" />

    <!-- Layer 3: Top Center Handle Capsule Indicator -->
    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_glass_pill"
        android:alpha="0.5" />

    <!-- Layer 4: Apple Music Live Lyrics Split Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="64dp"
        android:paddingTop="36dp"
        android:paddingEnd="56dp"
        android:paddingBottom="36dp">

        <!-- Left Column: Album Artwork Card -->
        <FrameLayout
            android:layout_width="400dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical">

            <androidx.cardview.widget.CardView
                android:layout_width="360dp"
                android:layout_height="360dp"
                android:layout_gravity="center"
                app:cardBackgroundColor="#1A2026"
                app:cardCornerRadius="24dp"
                app:cardElevation="32dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/imgDefaultMusicIcon"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_gravity="center"
                        android:alpha="0.3"
                        android:src="@drawable/ic_music_note"
                        app:tint="@color/text_white" />

                    <ImageView
                        android:id="@+id/imgAlbumCover"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop" />

                    <!-- Subtle glass edge border -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_pin_box"
                        android:alpha="0.3" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>
        </FrameLayout>

        <!-- Right Column: Track Info Header + Live Time-Synced Lyrics -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="36dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Apple Music Header: Track Name, Artist & Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtTrackTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/sf_pro_rounded"
                        android:maxLines="1"
                        android:text="Título da Música"
                        android:textColor="@color/text_white"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtArtistName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/sf_pro_display"
                        android:maxLines="1"
                        android:text="Nome do Artista"
                        android:textColor="#A6FFFFFF"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- Action Icons: Favorite Star & More Options -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btnFavoriteStar"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="18dp"
                        android:alpha="0.85"
                        android:src="@drawable/ic_star_outline"
                        app:tint="@color/text_white" />

                    <ImageView
                        android:id="@+id/btnMoreOptions"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:alpha="0.85"
                        android:src="@drawable/ic_more_dots"
                        app:tint="@color/text_white" />
                </LinearLayout>
            </LinearLayout>

            <!-- Time-Synced Lyrics Container -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerLyrics"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:requiresFadingEdge="vertical"
                    android:fadingEdgeLength="60dp"
                    android:paddingTop="70dp"
                    android:paddingBottom="220dp" />

                <!-- Fallback when lyrics are unavailable -->
                <TextView
                    android:id="@+id/txtNoLyrics"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:fontFamily="@font/sf_pro_rounded"
                    android:text="Letras indisponíveis para esta faixa"
                    android:textColor="#50FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- Legacy compatibility stub -->
    <TextView
        android:id="@+id/txtAlbumName"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</FrameLayout>
