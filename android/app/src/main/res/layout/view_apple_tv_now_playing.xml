<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_obsidian">

    <!-- Layer 1: Blurred Ambient Glow from Album Art (Apple Music dynamic atmosphere) -->
    <ImageView
        android:id="@+id/imgAmbientGlow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.55"
        android:scaleType="centerCrop" />

    <!-- Layer 2: Apple Dark Radial Scrim for Contrast -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#A608080C" />

    <!-- Layer 3: Top Center Handle Capsule Indicator -->
    <View
        android:layout_width="36dp"
        android:layout_height="5dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_glass_pill"
        android:alpha="0.4" />

    <!-- ========================================================================= -->
    <!-- MODE A: Centered Cover Art Design ("Sem Letras - Do Jeito Que Tava Antes") -->
    <!-- ========================================================================= -->
    <LinearLayout
        android:id="@+id/layoutNowPlayingCentered"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:visibility="gone">

        <!-- Album Cover Art (tvOS centered card with elevation shadow) -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="380dp"
                android:layout_height="380dp"
                android:layout_gravity="center"
                app:cardCornerRadius="28dp"
                app:cardElevation="36dp"
                app:cardBackgroundColor="#1A2228">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/imgDefaultMusicIconCentered"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_gravity="center"
                        android:alpha="0.3"
                        android:src="@drawable/ic_music_note"
                        app:tint="@color/text_white" />

                    <ImageView
                        android:id="@+id/imgAlbumCoverCentered"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop" />

                    <!-- Apple TV Glass Edge Stroke -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_pin_box"
                        android:alpha="0.32" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>
        </FrameLayout>

        <!-- Track & Artist Info Centered Underneath -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTrackTitleCentered"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/sf_pro_display"
                android:gravity="center"
                android:maxWidth="750dp"
                android:maxLines="2"
                android:text="Título da Música"
                android:textAlignment="center"
                android:textColor="@color/text_white"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtArtistNameCentered"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:fontFamily="@font/sf_pro_display"
                android:gravity="center"
                android:maxWidth="750dp"
                android:maxLines="1"
                android:text="Nome do Artista"
                android:textAlignment="center"
                android:textColor="#E0E0E0"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/txtAlbumNameCentered"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="@font/sf_pro_display"
                android:gravity="center"
                android:maxWidth="750dp"
                android:maxLines="1"
                android:text="Álbum"
                android:textAlignment="center"
                android:textColor="#80FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ========================================================================= -->
    <!-- MODE B: AMLL Apple Music Like Lyrics Design ("Com Letras")                -->
    <!-- Left: Album Cover Card ONLY (centered). Right: Song Info + Synced Lyrics   -->
    <!-- No microphone/transport/scrubber/queue buttons - pure clean design!       -->
    <!-- ========================================================================= -->
    <LinearLayout
        android:id="@+id/layoutNowPlayingLyrics"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="64dp"
        android:paddingTop="36dp"
        android:paddingEnd="48dp"
        android:paddingBottom="36dp"
        android:visibility="visible">

        <!-- Left Pane: Album Artwork Card (alone, vertically centered) -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingEnd="32dp">

            <androidx.cardview.widget.CardView
                android:layout_width="360dp"
                android:layout_height="360dp"
                android:layout_gravity="center"
                app:cardBackgroundColor="#1A2026"
                app:cardCornerRadius="26dp"
                app:cardElevation="32dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/imgDefaultMusicIconLyrics"
                        android:layout_width="92dp"
                        android:layout_height="92dp"
                        android:layout_gravity="center"
                        android:alpha="0.25"
                        android:src="@drawable/ic_music_note"
                        app:tint="@color/text_white" />

                    <ImageView
                        android:id="@+id/imgAlbumCoverLyrics"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop" />

                    <!-- Subtle glass edge border -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_pin_box"
                        android:alpha="0.28" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>
        </FrameLayout>

        <!-- Right Pane: Track Title + Artist Header + AMLL Apple Music Like Lyrics -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="24dp"
            android:layout_weight="1.35"
            android:orientation="vertical">

            <!-- Track Title and Artist Name at the top of the right column -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtTrackTitleLyrics"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/sf_pro_rounded"
                    android:maxLines="2"
                    android:text="Título da Música"
                    android:textColor="@color/text_white"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtArtistNameLyrics"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/sf_pro_display"
                    android:maxLines="1"
                    android:text="Nome do Artista"
                    android:textColor="#B3FFFFFF"
                    android:textSize="19sp" />
            </LinearLayout>

            <!-- Scrolling Synced Lyrics or Empty Placeholder -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerLyrics"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:requiresFadingEdge="vertical"
                    android:fadingEdgeLength="60dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="220dp" />

                <TextView
                    android:id="@+id/txtNoLyrics"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:fontFamily="@font/sf_pro_rounded"
                    android:text="Letras indisponíveis para esta faixa"
                    android:textColor="#50FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Legacy compatibility stubs for unused view IDs -->
    <TextView
        android:id="@+id/txtTrackTitle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtArtistName"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtAlbumName"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/imgAlbumCover"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/imgDefaultMusicIcon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/scrubberProgressBar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtTimeElapsed"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtTimeRemaining"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/volumeProgressBar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</FrameLayout>
