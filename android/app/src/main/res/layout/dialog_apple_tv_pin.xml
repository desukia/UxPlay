<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B3000000"
    android:clickable="true"
    android:focusable="true">

    <!-- Center Modal Card (tvOS Glass) -->
    <LinearLayout
        android:layout_width="620dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_frosted_card"
        android:elevation="28dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="42dp"
        android:paddingEnd="48dp"
        android:paddingBottom="42dp">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/ic_airplay" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pin_title"
            android:textColor="@color/text_white"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/pin_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

        <!-- 4 Digit Boxes -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:layout_marginBottom="28dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtPinDigit1"
                android:layout_width="80dp"
                android:layout_height="96dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_pin_box"
                android:fontFamily="@font/sf_pro_rounded"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/text_white"
                android:textSize="48sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtPinDigit2"
                android:layout_width="80dp"
                android:layout_height="96dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_pin_box"
                android:fontFamily="@font/sf_pro_rounded"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/text_white"
                android:textSize="48sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtPinDigit3"
                android:layout_width="80dp"
                android:layout_height="96dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_pin_box"
                android:fontFamily="@font/sf_pro_rounded"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/text_white"
                android:textSize="48sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtPinDigit4"
                android:layout_width="80dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_pin_box"
                android:fontFamily="@font/sf_pro_rounded"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/text_white"
                android:textSize="48sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pin_hint"
            android:textColor="#66FFFFFF"
            android:textSize="13sp" />

    </LinearLayout>

</FrameLayout>
