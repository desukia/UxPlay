<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_obsidian"
    android:keepScreenOn="true">

    <!-- 1. Active Mirroring Video Layer (Hardware SurfaceView kept ready at base) -->
    <include
        android:id="@+id/layoutMirror"
        layout="@layout/view_apple_tv_mirror"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible" />

    <!-- 2. Ambient / Idle Apple TV Aerial Screensaver Layer (Covers mirror when idle) -->
    <include
        android:id="@+id/layoutAmbient"
        layout="@layout/view_apple_tv_ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible" />

    <!-- 3. Music Now Playing Layer -->
    <include
        android:id="@+id/layoutNowPlaying"
        layout="@layout/view_apple_tv_now_playing"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 4. tvOS 4-Digit PIN Code Dialog Overlay -->
    <include
        android:id="@+id/layoutPinDialog"
        layout="@layout/dialog_apple_tv_pin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>
