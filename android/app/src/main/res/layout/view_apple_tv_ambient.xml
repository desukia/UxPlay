<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_obsidian">

    <!-- Subtle aerial backdrop screensaver -->
    <ImageView
        android:id="@+id/imgAerialBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/tv_banner"
        android:alpha="0.22" />

    <!-- Dark vignette overlay for deep Apple TV contrast -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D0000000" />

    <!-- Minimalist Apple TV Idle Centerpiece -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <!-- AirPlay Icon -->
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="18dp"
            android:src="@drawable/ic_airplay"
            app:tint="@color/text_white" />

        <!-- "AirPlay" Title with Apple SF Pro Display Font -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sf_pro_display"
            android:letterSpacing="0.03"
            android:text="@string/airplay_title"
            android:textColor="@color/text_white"
            android:textSize="50sp"
            android:textStyle="bold" />

        <!-- Discreet Device Name Subtitle -->
        <TextView
            android:id="@+id/txtHeaderDeviceName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/sf_pro_display"
            android:text="Apple TV"
            android:textColor="#80FFFFFF"
            android:textSize="17sp" />

        <!-- Apple TV Settings Button with Apple SF Pro Font -->
        <LinearLayout
            android:id="@+id/btnSettingsShortcut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:background="@drawable/bg_tvos_button_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="28dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_settings"
                app:tint="@color/color_tvos_button_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sf_pro_display"
                android:text="Ajustes"
                android:textColor="@color/color_tvos_button_text"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Hidden legacy compatibility stubs (preventing null pointer exceptions) -->
    <TextView
        android:id="@+id/txtClock"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtWifiSsid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtInstructionStep3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</FrameLayout>
